---
// Kontakti + footer: një kartë e errët. Mobile dhe desktop kanë renditje pak të ndryshme
// (nga Figma) — elementet që i takojnë vetëm njërit shfaqen/fshihen me CSS.
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import { PHONE, PHONE_DISPLAY, INSTAGRAM, INSTAGRAM_HANDLE, MAPS_URL, waLink } from '../data/site';
import { T, section, type Lang } from '../i18n';
import { ELBASAN } from '../data/locations';

interface Props { lang: Lang }
const { lang } = Astro.props;
const all = T[lang];
const t = all.contact;
---

<footer class="contact" id="kontakti">
  <div class="panel">
    <div class="cta">
      <div class="text">
        <p class="kicker">{t.kicker}</p>
        <h2 class="title fill-text">{t.title[0]} <br class="d-only" />{t.title[1]}</h2>
        <p class="lead">{t.lead}</p>
      </div>
      <div class="btns">
        <a href={waLink(all.wa.default)} class="btn btn--lime" target="_blank" rel="noopener">
          <img src="/img/wa-dark.svg" alt="" width="18" height="18" />{t.bookWa}
        </a>
        <a href={`tel:${PHONE}`} class="btn call">
          <img src="/img/phone-btn.svg" alt="" width="17" height="17" />{t.call} {PHONE_DISPLAY}
        </a>
      </div>
    </div>

    <hr />

    <div class="cols">
      <div class="brand d-only">
        <Image src={logo} alt="MRentals" width={189} densities={[1, 2]} loading="lazy" />
        <p>{t.brand[0]} <br />{t.brand[1]}</p>
      </div>
      <nav class="col d-only" aria-label={t.pages}>
        <p class="h">{t.pages}</p>
        {all.nav.map((l) => <a href={section(lang, l.id)}>{l.label}</a>)}
      </nav>
      <div class="col">
        <p class="h">{t.office}</p>
        <p>{t.city}</p>
        <a href={ELBASAN.path[lang]}>{t.locLink}</a>
        <a href={MAPS_URL} target="_blank" rel="noopener">{t.openMaps}</a>
      </div>
      <div class="col">
        <p class="h">{t.contactH}</p>
        <a href={`tel:${PHONE}`} class="ico"><img src="/img/phone-sm.svg" alt="" width="15" height="15" />{PHONE_DISPLAY}</a>
        <a href={INSTAGRAM} class="ico" target="_blank" rel="noopener"><img src="/img/ig.svg" alt="" width="15" height="15" />{INSTAGRAM_HANDLE}</a>
      </div>
    </div>

    <nav class="foot-nav m-only" aria-label="Footer">
      {all.nav.map((l) => <a href={section(lang, l.id)}>{l.label}</a>)}
    </nav>

    <div class="bottom">
      <span class="m-only"><Image src={logo} alt="MRentals" width={129} densities={[1, 2]} loading="lazy" /></span>
      <p>© 2026 MRentals</p>
      <p class="d-only">{t.bottom} {PHONE_DISPLAY}</p>
    </div>
  </div>
</footer>

<style>
  .contact { padding: 56px 12px 12px; }
  .panel {
    max-width: 640px;
    margin: 0 auto;
    background: var(--ink);
    border-radius: 28px;
    padding: 40px 24px 28px;
    display: flex; flex-direction: column; gap: 14px;
    color: rgba(255, 255, 255, .85);
  }
  @media (max-width: 1023.98px) { .d-only { display: none !important; } }

  .cta, .text { display: flex; flex-direction: column; gap: 14px; }
  .kicker {
    font-family: var(--f-label); font-weight: 700; font-size: 12px;
    letter-spacing: .14em; text-transform: uppercase; color: var(--lime);
  }
  .title {
    font-family: var(--f-display); font-weight: 600;
    font-size: 36px; line-height: 1.02; letter-spacing: -0.035em;
    color: #fff;
    /* mbushja me scroll: nga gri e errët në të bardhë */
    --fill: #fff;
    --empty: rgba(255, 255, 255, .2);
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .title { color: transparent; }
    }
  }
  .lead { font-size: 15px; line-height: 1.45; color: rgba(255, 255, 255, .65); }
  .btns { display: flex; flex-direction: column; gap: 10px; padding-top: 10px; }
  .btns .btn { width: 100%; padding: 16px 0; font-size: 15px; }
  .call { border: 1px solid rgba(255, 255, 255, .18); color: rgba(255, 255, 255, .85); }
  .call:hover { border-color: rgba(255, 255, 255, .35); }

  hr { border: 0; height: 1px; background: rgba(255, 255, 255, .1); }

  .cols { display: flex; gap: 16px; }
  .col { flex: 1; display: flex; flex-direction: column; gap: 10px; font-size: 14px; white-space: nowrap; }
  .col a:hover, .foot-nav a:hover { color: #fff; }
  .h {
    font-family: var(--f-label); font-weight: 700; font-size: 11px;
    letter-spacing: .12em; text-transform: uppercase; color: rgba(255, 255, 255, .45);
  }
  .ico { display: flex; align-items: center; gap: 8px; white-space: nowrap; }

  .foot-nav { display: flex; gap: 16px; font-weight: 500; font-size: 13px; color: rgba(255, 255, 255, .6); }
  .bottom { display: flex; align-items: center; justify-content: space-between; font-size: 12px; color: rgba(255, 255, 255, .45); }
  .bottom :global(img) { width: 129px; height: auto; }

  @media (min-width: 1024px) {
    .contact { padding: 120px 24px 24px; }
    .panel { max-width: none; border-radius: 36px; padding: 88px 96px 40px; gap: 40px; }
    .m-only { display: none !important; }
    .cta { flex-direction: row; align-items: flex-end; justify-content: space-between; gap: 40px; }
    .text { gap: 16px; }
    .kicker { font-size: 13px; }
    .title { font-size: 64px; line-height: .98; letter-spacing: -0.035em; }
    .lead { font-size: 17px; line-height: normal; }
    .btns { flex: none; width: 320px; gap: 12px; padding-top: 0; }
    .btns .btn { padding: 18px 0; font-size: 16px; }
    .cols { gap: 80px; }
    .brand { flex: 1; display: flex; flex-direction: column; gap: 14px; font-size: 14px; color: rgba(255, 255, 255, .55); }
    .brand :global(img) { width: 189px; height: auto; }
    .col { flex: none; gap: 12px; font-size: 15px; }
    .h { font-size: 12px; }
    .bottom { font-size: 13px; }
  }
</style>
