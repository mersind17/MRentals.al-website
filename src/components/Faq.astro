---
import { waLink } from '../data/site';
import { T, type Lang } from '../i18n';

interface Props { lang: Lang }
const all = T[Astro.props.lang];
const t = all.faq;
---

<section class="faq wrap" id="faq" aria-labelledby="faq-title">
  <div class="left">
    <div class="sec-head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="h2" id="faq-title">{t.title}</h2>
      <p class="lead">
        <span class="m-text">{t.leadShort}</span>
        <span class="d-text">{t.leadLong}</span>
      </p>
    </div>
    <a href={waLink(all.wa.question)} class="btn btn--dark wa" target="_blank" rel="noopener">
      <img src="/img/wa-light.svg" alt="" width="18" height="18" />{t.cta}
    </a>
  </div>

  <!-- <details> punon pa JavaScript dhe Google e lexon përmbajtjen -->
  <div class="list">
    {t.items.map((f, i) => (
      <details class="item reveal-up" name="faq" open={i === 0}>
        <summary>
          <h3>{f.q}</h3>
          <span class="sign" aria-hidden="true"></span>
        </summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq { display: flex; flex-direction: column; gap: 24px; padding: 72px 0 24px; }
  .lead { font-size: 15px; line-height: 1.45; color: var(--muted); }
  .d-text, .wa { display: none; }

  .list { display: flex; flex-direction: column; gap: 8px; }
  .item {
    background: #fff;
    border-radius: 18px;
    padding: 18px 20px;
    interpolate-size: allow-keywords;
  }
  summary {
    display: flex; align-items: center; gap: 12px;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker { display: none; }
  h3 { flex: 1; font-weight: 600; font-size: 16px; line-height: normal; color: var(--ink-2); }
  /* + që kthehet në – */
  .sign { position: relative; flex: none; width: 12px; height: 12px; }
  .sign::before, .sign::after {
    content: '';
    position: absolute; left: 0; top: 50%;
    width: 100%; height: 1.5px;
    background: var(--ink-2);
    translate: 0 -50%;
    transition: rotate .3s var(--ease-out);
  }
  .sign::after { rotate: 90deg; }
  [open] .sign::after { rotate: 0deg; }
  .item p { padding-top: 10px; font-size: 14px; line-height: 1.5; color: var(--muted); }
  /* hapja e butë (shfletuesit e rinj) */
  .item::details-content {
    block-size: 0;
    overflow: clip;
    transition: block-size .35s var(--ease-out), content-visibility .35s allow-discrete;
  }
  .item[open]::details-content { block-size: auto; }

  @media (min-width: 1024px) {
    .faq { flex-direction: row; align-items: flex-start; gap: 64px; padding-top: 120px; padding-bottom: 0; }
    .left { flex: none; width: 400px; display: flex; flex-direction: column; gap: 16px; }
    .left .sec-head { gap: 16px; }
    .lead { font-size: 17px; line-height: 1.5; }
    .m-text { display: none; }
    .d-text { display: inline; }
    .wa { display: inline-flex; align-self: flex-start; padding: 15px 24px; font-size: 16px; }
    .list { flex: 1; gap: 10px; }
    .item { border-radius: 20px; padding: 22px 28px; }
    h3 { font-size: 18px; }
    .sign { width: 14px; height: 14px; }
    .item p { padding-top: 12px; font-size: 16px; line-height: 1.55; }
  }
</style>
